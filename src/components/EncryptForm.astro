---
import Icon from "./Icon.astro";
import { DURATION_UNITS } from "../lib/unlock";

const presets: [amount: number, unit: string, label: string][] = [
	[5, "minutes", "5 min"],
	[1, "hours", "1 hour"],
	[1, "days", "1 day"],
	[7, "days", "1 week"],
	[30, "days", "30 days"],
	[365, "days", "1 year"],
];
---

<section id="encrypt" class="Box" aria-labelledby="encrypt-title">
	<div class="Box-header compact">
		<h2 class="Box-title" id="encrypt-title">Encrypt a message</h2>
		<span class="small muted">Runs in your browser</span>
	</div>
	<div class="Box-body">
		<form id="encrypt-form" novalidate>
			<div class="field">
				<label for="message">Message</label>
				<textarea id="message" name="message" rows="3" required placeholder="Write a message to read later."></textarea>
				<p class="status err message-error" data-message-error role="alert" hidden>Write a message to encrypt.</p>
			</div>

			<fieldset class="field">
				<legend>When can it be opened?</legend>
				<div class="segmented" role="tablist" aria-label="How to choose the unlock time">
					<button type="button" role="tab" id="tab-duration" aria-selected="true" aria-controls="panel-duration" data-mode="duration">After a duration</button>
					<button type="button" role="tab" id="tab-date" aria-selected="false" aria-controls="panel-date" data-mode="date">At a date &amp; time</button>
				</div>

				<div id="panel-duration" class="panel" role="tabpanel" aria-labelledby="tab-duration">
					<div class="duration-inputs">
						<label for="amount" class="sr-only">Amount</label>
						<input type="number" id="amount" name="amount" value="5" min="1" step="1" inputmode="decimal" />
						<label for="unit" class="sr-only">Unit</label>
						<select id="unit" name="unit">
							{DURATION_UNITS.map((u) => <option value={u.value} selected={u.value === "minutes"}>{u.label}</option>)}
						</select>
					</div>
					<div class="chips" aria-label="Quick picks">
						{
							presets.map(([amount, unit, label]) => (
								<button type="button" class="chip" data-amount={amount} data-unit={unit} aria-pressed={amount === 5 && unit === "minutes" ? "true" : "false"}>
									{label}
								</button>
							))
						}
					</div>
				</div>

				<div id="panel-date" class="panel" role="tabpanel" aria-labelledby="tab-date" hidden>
					<div class="date-picker">
						<div class="calendar" data-calendar>
							<div class="calendar-head">
								<button type="button" class="icon-btn" data-prev aria-label="Previous month">‹</button>
								<span class="calendar-title" data-month-title aria-live="polite"></span>
								<button type="button" class="icon-btn" data-next aria-label="Next month">›</button>
							</div>
							<table class="calendar-grid" role="grid">
								<thead><tr>{["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"].map((d) => <th scope="col">{d}</th>)}</tr></thead>
								<tbody data-days></tbody>
							</table>
						</div>
						<div class="date-fields">
							<div>
								<label for="unlock-time">Time</label>
								<input type="time" id="unlock-time" name="unlock-time" value="09:00" step="60" />
							</div>
							<div>
								<label for="time-zone">Time zone</label>
								<select id="time-zone" name="time-zone"></select>
								<p class="hint" data-tz-hint>Uses your browser's time zone.</p>
							</div>
						</div>
					</div>
				</div>
			</fieldset>

			<div class="feedback" data-feedback>
				<div class="feedback-line">
					<Icon name="clock" />
					<span>Unlocks <strong data-local>—</strong></span>
				</div>
				<div class="feedback-sub muted"><span data-utc>—</span> · <span data-round>—</span></div>
				<div class="feedback-sub">In <strong data-duration>—</strong></div>
			</div>
			<p class="status err" data-error role="alert" hidden></p>

			<fieldset class="field notes-options" data-notes-options>
				<legend>Plain notes above the encrypted block</legend>
				<label class="check"><input type="checkbox" data-note="instructions" checked /> Include unlock instructions</label>
				<label class="check"><input type="checkbox" data-note="unlockTime" checked /> Include human-readable unlock time</label>
				<p class="hint">Notes aren't encrypted, and anyone can edit them. Other tools need only the BEGIN…END block. <a href="/faq#notes">About notes</a></p>
			</fieldset>

			<div class="row" data-submit-row>
				<button class="btn" type="submit">Encrypt</button>
				<span class="hint">Your message is encrypted on this page and is not sent to us.</span>
			</div>
		</form>

		<div data-result hidden>
			<div data-result-status></div>
			<div class="block-head">
				<label for="ciphertext">Encrypted block</label>
				<button type="button" class="link-btn" data-copy-block>Copy block only</button>
			</div>
			<textarea id="ciphertext" class="code" rows="7" readonly spellcheck="false"></textarea>
			<div data-notes-slot></div>
			<div class="copy-preview">
				<p class="copy-preview-title" id="copy-preview-title">Copy and Download give you exactly this</p>
				<pre data-preview aria-labelledby="copy-preview-title" tabindex="0"></pre>
			</div>
			<div class="row result-actions">
				<button class="btn" type="button" data-copy>Copy</button>
				<button class="btn secondary" type="button" data-download>Download .age file</button>
				<button class="btn secondary" type="button" data-to-decrypt><Icon name="arrowDown" />Paste into Decrypt below</button>
				<button class="btn secondary" type="button" data-again>Encrypt another</button>
			</div>
			<p class="hint">Anyone with this text can read the message after the unlock time. Nobody can read it before then. We don't keep a copy, so save it somewhere safe.</p>
		</div>
	</div>
</section>

<style>
	.panel {
		margin-top: 4px;
	}
	.duration-inputs {
		display: flex;
		gap: 8px;
		margin-bottom: 8px;
	}
	.duration-inputs input {
		width: 120px;
	}
	.duration-inputs select {
		width: auto;
		min-width: 120px;
	}
	.date-picker {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: flex-start;
	}
	.calendar {
		width: 264px;
		max-width: 100%;
		padding: 8px;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
	}
	.calendar-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 4px;
	}
	.calendar-title {
		font-weight: 600;
	}
	.icon-btn {
		width: 28px;
		height: 28px;
		border: 0;
		border-radius: var(--radius);
		background: transparent;
		font-size: 18px;
		line-height: 1;
		color: var(--muted);
		cursor: pointer;
	}
	.icon-btn:hover:not(:disabled) {
		background: var(--canvas-subtle);
		color: var(--text);
	}
	.icon-btn:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}
	.calendar-grid {
		width: 100%;
		margin: 0;
		table-layout: fixed;
	}
	.date-fields {
		display: grid;
		gap: 16px;
		flex: 1;
		min-width: 200px;
	}
	.date-fields input,
	.date-fields select {
		width: 100%;
	}
	.feedback {
		margin: 0 0 16px;
		padding: 12px 16px;
		border: 1px solid var(--mint-border);
		border-radius: var(--radius-lg);
		background: var(--mint);
	}
	.feedback.is-invalid {
		border-color: var(--border);
		background: var(--canvas-subtle);
		color: var(--muted);
	}
	.feedback-line {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		font-size: 14px;
	}
	.feedback-line .octicon {
		margin-top: 2px;
		color: var(--green);
	}
	.feedback.is-invalid .octicon {
		color: var(--muted);
	}
	.feedback-sub {
		margin: 2px 0 0 24px;
		font-size: 12px;
	}
	.result-title {
		margin-top: 0;
	}
	.message-error {
		margin: 8px 0 0;
	}
	.result-actions {
		margin-top: 12px;
	}
	.notes-options .check {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 6px;
		font-weight: 400;
		cursor: pointer;
	}
	.notes-options .check input {
		width: 16px;
		height: 16px;
		margin: 0;
		accent-color: var(--green);
	}
	.notes-options .hint {
		margin: 2px 0 0;
	}
	[data-notes-slot] .notes-options {
		margin: 12px 0 0;
	}
	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
		margin-top: 16px;
	}
	.block-head label {
		margin: 0 0 6px;
	}
	.link-btn {
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		font-size: 12px;
		color: var(--link);
		cursor: pointer;
	}
	.link-btn:hover {
		text-decoration: underline;
	}
	.copy-preview {
		margin-top: 12px;
	}
	.copy-preview-title {
		margin: 0 0 4px;
		font-size: 12px;
		font-weight: 600;
		color: var(--muted);
	}
	.copy-preview pre {
		max-height: 9.5em;
		margin: 0;
		padding: 8px 12px;
		overflow: auto;
		border: 1px dashed var(--border);
		border-radius: var(--radius);
		background: var(--canvas-subtle);
		font-size: 11px;
		line-height: 1.45;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>
<style is:global>
	.copy-preview .note-line {
		color: var(--green-text);
		font-weight: 600;
	}
</style>
<style is:global>
	.calendar-grid tr,
	.calendar-grid tbody tr:nth-child(2n) {
		background: none;
	}
	.calendar-grid th,
	.calendar-grid td {
		padding: 1px;
		border: 0;
		text-align: center;
	}
	.calendar-grid th {
		font-size: 12px;
		font-weight: 400;
		color: var(--muted);
		padding-bottom: 4px;
	}
	.calendar-grid button {
		width: 100%;
		height: 32px;
		border: 1px solid transparent;
		border-radius: var(--radius);
		background: transparent;
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		cursor: pointer;
	}
	.calendar-grid button:hover:not(:disabled) {
		background: var(--canvas-subtle);
		border-color: var(--border);
	}
	.calendar-grid button:disabled {
		color: #8c959f;
		text-decoration: line-through;
		text-decoration-color: #d1d9e0;
		cursor: not-allowed;
	}
	.calendar-grid button.is-today {
		font-weight: 600;
		border-color: var(--border);
	}
	.calendar-grid button[aria-pressed="true"] {
		background: var(--link);
		border-color: var(--link);
		color: #ffffff;
		font-weight: 600;
	}
</style>

<script>
	import { createDrandClient, roundForTime, roundTime } from "../lib/drand";
	import { encrypt } from "../lib/tlock";
	import { encryptedPanelHtml } from "../lib/status";
	import { noteLines, withNotes } from "../lib/notes";
	import { detectTimeZone, formatDuration, formatLocal, formatUtc, zonedParts } from "../lib/time";
	import { addMonths, compareDays, dateTarget, durationTarget, MAX_LOCK_SECONDS, monthGrid, todayIn, timeZoneList, type Day, type Target } from "../lib/unlock";
	import { reportEvent } from "../scripts/report";

	const form = document.querySelector<HTMLFormElement>("#encrypt-form")!;
	const section = document.querySelector<HTMLElement>("#encrypt")!;
	const $ = <T extends HTMLElement>(sel: string) => section.querySelector<T>(sel)!;
	const amountInput = $<HTMLInputElement>("#amount");
	const unitSelect = section.querySelector("#unit") as unknown as HTMLSelectElement;
	const timeInput = $<HTMLInputElement>("#unlock-time");
	const zoneSelect = section.querySelector("#time-zone") as unknown as HTMLSelectElement;
	const daysBody = $("[data-days]");
	const errorBox = $("[data-error]");
	const feedback = $("[data-feedback]");
	const result = $("[data-result]");
	const client = createDrandClient();
	const browserZone = detectTimeZone();

	let mode: "duration" | "date" = "duration";
	let lockedUntil = 0;
	let lockedRound = 0;
	let resultHtml = "";
	let armored = "";
	let noteZone = browserZone;
	let zone = browserZone;
	let selected: Day | null = null;
	let view = { year: 0, month: 0 };

	zoneSelect.replaceChildren(
		...timeZoneList(browserZone).map((z) => new Option(z === browserZone ? `${z.replace(/_/g, " ")} (detected)` : z.replace(/_/g, " "), z, z === zone, z === zone)),
	);
	const tzHint = $("[data-tz-hint]");

	{
		const today = todayIn(zone, Date.now());
		const tomorrow = new Date(Date.UTC(today.year, today.month - 1, today.day + 1));
		selected = { year: tomorrow.getUTCFullYear(), month: tomorrow.getUTCMonth() + 1, day: tomorrow.getUTCDate() };
		view = { year: selected.year, month: selected.month };
	}

	const monthName = (y: number, m: number) => new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric", timeZone: "UTC" }).format(Date.UTC(y, m - 1, 1));
	const dayLabel = (d: Day) => new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(Date.UTC(d.year, d.month - 1, d.day));
	const pad = (n: number) => String(n).padStart(2, "0");
	let calendarKey = "";

	function renderCalendar(now: number) {
		const today = todayIn(zone, now);
		const last = zonedParts(now + MAX_LOCK_SECONDS * 1000, zone);
		const key = `${zone}|${view.year}-${view.month}|${today.year}-${today.month}-${today.day}|${selected ? `${selected.year}-${selected.month}-${selected.day}` : ""}`;
		if (key === calendarKey) return;
		calendarKey = key;
		$("[data-month-title]").textContent = monthName(view.year, view.month);
		$<HTMLButtonElement>("[data-prev]").disabled = view.year * 12 + view.month <= today.year * 12 + today.month;
		$<HTMLButtonElement>("[data-next]").disabled = view.year * 12 + view.month >= last.year * 12 + last.month;
		daysBody.replaceChildren(
			...monthGrid(view.year, view.month).map((week) => {
				const tr = document.createElement("tr");
				for (const d of week) {
					const td = document.createElement("td");
					if (d) {
						const b = document.createElement("button");
						b.type = "button";
						b.textContent = String(d.day);
						b.setAttribute("aria-label", dayLabel(d));
						b.disabled = compareDays(d, today) < 0 || compareDays(d, last) > 0;
						if (compareDays(d, today) === 0) b.classList.add("is-today");
						b.setAttribute("aria-pressed", String(!!selected && compareDays(d, selected) === 0));
						b.addEventListener("click", () => {
							selected = d;
							render();
						});
						td.appendChild(b);
					}
					tr.appendChild(td);
				}
				return tr;
			}),
		);
	}

	function target(now: number): Target {
		return mode === "duration" ? durationTarget(amountInput.value, unitSelect.value, now) : dateTarget(selected, timeInput.value, zone, now);
	}

	function render() {
		const now = Date.now();
		const set = (sel: string, text: string) => ($(sel).textContent = text);
		if (mode === "date") {
			renderCalendar(now);
			const today = todayIn(zone, now);
			const min = selected && compareDays(selected, today) === 0 ? (({ hour, minute }) => `${pad(hour)}:${pad(minute)}`)(zonedParts(now + 60_000, zone)) : "";
			if (timeInput.min !== min) timeInput.min = min;
			tzHint.textContent = zone === browserZone ? "Detected from your browser. Change it if the time is for another place." : `Times are in ${zone.replace(/_/g, " ")}. Your browser is set to ${browserZone.replace(/_/g, " ")}.`;
		}
		section.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) => {
			chip.setAttribute("aria-pressed", String(chip.dataset.unit === unitSelect.value && Number(chip.dataset.amount) === Number(amountInput.value)));
		});
		const t = target(now);
		if ("error" in t) {
			for (const sel of ["[data-local]", "[data-utc]", "[data-duration]", "[data-round]"]) set(sel, "—");
			feedback.classList.add("is-invalid");
			if (errorBox.textContent !== t.error) errorBox.textContent = t.error;
			errorBox.hidden = false;
			return;
		}
		errorBox.hidden = true;
		feedback.classList.remove("is-invalid");
		const round = roundForTime(t.ms);
		const at = roundTime(round);
		const shownZone = mode === "date" ? zone : browserZone;
		set("[data-local]", `${formatLocal(at, { timeZone: shownZone })} (${shownZone.replace(/_/g, " ")})`);
		set("[data-utc]", formatUtc(at));
		set("[data-round]", `drand round #${round.toLocaleString("en-US")}`);
		set("[data-duration]", formatDuration(Math.round(((mode === "duration" ? t.ms : at) - now) / 1000)));
	}

	function setMode(next: typeof mode) {
		mode = next;
		section.querySelectorAll<HTMLButtonElement>("[role=tab]").forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.mode === mode)));
		$("#panel-duration").hidden = mode !== "duration";
		$("#panel-date").hidden = mode !== "date";
		render();
	}

	section.querySelectorAll<HTMLButtonElement>("[role=tab]").forEach((tab) => tab.addEventListener("click", () => setMode(tab.dataset.mode as typeof mode)));
	section.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) =>
		chip.addEventListener("click", () => {
			amountInput.value = chip.dataset.amount!;
			unitSelect.value = chip.dataset.unit!;
			render();
		}),
	);
	$("[data-prev]").addEventListener("click", () => {
		view = addMonths(view.year, view.month, -1);
		render();
	});
	$("[data-next]").addEventListener("click", () => {
		view = addMonths(view.year, view.month, 1);
		render();
	});
	zoneSelect.addEventListener("change", () => {
		zone = zoneSelect.value;
		render();
	});
	$("#message").addEventListener("input", () => ($("[data-message-error]").hidden = true));
	for (const el of [amountInput, unitSelect, timeInput]) {
		el.addEventListener("input", render);
		el.addEventListener("change", render);
	}

	function renderResult() {
		const html = encryptedPanelHtml(lockedUntil, lockedRound, Date.now());
		if (html !== resultHtml) $("[data-result-status]").innerHTML = resultHtml = html;
	}

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		const message = $<HTMLTextAreaElement>("#message");
		const t = target(Date.now());
		if (!message.value.trim()) {
			$("[data-message-error]").hidden = false;
			message.focus();
			return;
		}
		if ("error" in t) {
			render();
			(mode === "duration" ? amountInput : timeInput).focus();
			return;
		}
		const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
		button.disabled = true;
		button.textContent = "Encrypting…";
		try {
			const round = roundForTime(t.ms);
			armored = await encrypt(new TextEncoder().encode(message.value), round, client);
			lockedUntil = roundTime(round);
			lockedRound = round;
			noteZone = mode === "date" ? zone : browserZone;
			$<HTMLTextAreaElement>("#ciphertext").value = armored;
			message.value = "";
			$("[data-notes-slot]").appendChild(notesOptions);
			form.hidden = true;
			result.hidden = false;
			renderResult();
			renderPreview();
			reportEvent("encrypt", round);
		} catch (err) {
			errorBox.textContent = `Encryption failed: ${err instanceof Error ? err.message : String(err)}`;
			errorBox.hidden = false;
		} finally {
			button.disabled = false;
			button.textContent = "Encrypt";
		}
	});

	const notesOptions = $("[data-notes-options]");
	const noteBox = (name: string) => notesOptions.querySelector<HTMLInputElement>(`[data-note="${name}"]`)!;
	const notes = () => noteLines(lockedUntil, { instructions: noteBox("instructions").checked, unlockTime: noteBox("unlockTime").checked, timeZone: noteZone });
	const ciphertext = () => withNotes(armored, notes());

	function renderPreview() {
		const lines = notes();
		const pre = $("[data-preview]");
		pre.replaceChildren(
			...lines.map((line) => Object.assign(document.createElement("span"), { className: "note-line", textContent: `${line}\n` })),
			document.createTextNode(lines.length ? `\n${armored}` : armored),
		);
	}
	notesOptions.querySelectorAll("input").forEach((box) => box.addEventListener("change", renderPreview));

	async function copyWithFeedback(button: HTMLButtonElement, text: string) {
		await navigator.clipboard.writeText(text);
		const label = button.textContent;
		button.textContent = "Copied";
		setTimeout(() => (button.textContent = label), 1500);
	}
	$("[data-copy]").addEventListener("click", (e) => copyWithFeedback(e.currentTarget as HTMLButtonElement, ciphertext()));
	$("[data-copy-block]").addEventListener("click", (e) => copyWithFeedback(e.currentTarget as HTMLButtonElement, armored));
	$("[data-download]").addEventListener("click", () => {
		const a = document.createElement("a");
		a.href = URL.createObjectURL(new Blob([ciphertext()], { type: "text/plain" }));
		a.download = `timelock-${new Date(lockedUntil).toISOString().replace(/[:.]/g, "-")}.age`;
		a.click();
		URL.revokeObjectURL(a.href);
	});
	$("[data-to-decrypt]").addEventListener("click", () => {
		window.dispatchEvent(new CustomEvent("timelock:decrypt", { detail: ciphertext() }));
	});
	$("[data-again]").addEventListener("click", () => {
		result.hidden = true;
		form.insertBefore(notesOptions, $("[data-submit-row]"));
		form.hidden = false;
		lockedUntil = 0;
		$<HTMLTextAreaElement>("#message").focus();
	});

	render();
	setInterval(() => {
		if (!form.hidden) render();
		if (lockedUntil) renderResult();
	}, 1000);
</script>
