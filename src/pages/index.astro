---
import { env } from "cloudflare:workers";
import Activity from "../components/Activity.astro";
import DecryptForm from "../components/DecryptForm.astro";
import EncryptForm from "../components/EncryptForm.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { ACTIVITY_LIMIT } from "../lib/activity";
import { LIMITS } from "../lib/api";
import { QUICKNET } from "../lib/drand";
import { eventStats, listEvents, type EventStats, type FeedEvent } from "../lib/events";

export const prerender = false;

const now = Date.now();
let events: FeedEvent[] | null = null;
let stats: EventStats | null = null;
if (env.DB) {
	try {
		[events, stats] = await Promise.all([listEvents(env.DB, { limit: ACTIVITY_LIMIT }), eventStats(env.DB, now)]);
	} catch (err) {
		console.error("failed to load activity", err);
	}
}
Astro.response.headers.set("Cache-Control", "no-cache");
const maxYears = LIMITS.maxUnlockSeconds / (365 * 86400);
---

<Base
	title="timelock.dev: send a message into the future"
	description="Encrypt a message in your browser so that nobody can read it until a time you pick. Uses the drand network. No account needed."
>
	<section class="hero">
		<div class="container">
			<h1>Send a message <span class="accent">into the future</span></h1>
			<p class="lead">
				Write a message and pick a time. Your browser encrypts it. Nobody can read it before that time, not even you or us. After that, anyone
				with the encrypted text can read it.
			</p>
			<p class="hero-links">
				<a href="#encrypt"><Icon name="lock" />Encrypt a message</a>
				<a href="#decrypt"><Icon name="unlock" />Have an encrypted message? Decrypt it below</a>
			</p>
		</div>
	</section>

	<div class="container layout">
		<div class="layout-main">
			<EncryptForm />
			<DecryptForm />
			<Activity events={events} stats={stats} now={now} />
		</div>

		<aside class="layout-side" aria-label="About timelock.dev">
			<section class="side-section">
				<h2>About</h2>
				<p>
					The key to open your message does not exist yet. The <a href="https://drand.love/">drand</a> network creates it at the unlock time and
					publishes it for everyone.
				</p>
				<ul class="facts">
					<li><Icon name="lock" /><span>Encrypts in your browser</span></li>
					<li><Icon name="clock" /><span>Locks for up to <strong>{maxYears} years</strong></span></li>
					<li><Icon name="pulse" /><span>A new drand key every <strong>{QUICKNET.period} seconds</strong></span></li>
					<li><Icon name="shield" /><span>No account, no cookies, no analytics</span></li>
				</ul>
			</section>
			<section class="side-section">
				<h2>Other ways to use it</h2>
				<ul class="facts">
					<li><Icon name="terminal" /><a href="/how-it-works#offline">Encrypt offline with a command-line tool</a></li>
					<li><Icon name="code" /><a href="/docs">JSON API for scripts</a></li>
					<li><Icon name="book" /><a href="/how-it-works">How it works and its limits</a></li>
					<li><Icon name="code" /><a href="https://github.com/timelock-dev/tlock-worker">Source code on GitHub</a></li>
				</ul>
			</section>
		</aside>
	</div>
</Base>
