---
import Base from "../layouts/Base.astro";
import { LIMITS } from "../lib/api";
import { QUICKNET, roundForTime, roundTime } from "../lib/drand";
import { STATS_DAYS } from "../lib/events";

const exRound = roundForTime(Date.parse("2026-10-22T01:05:03Z"));
const exUnlock = new Date(roundTime(exRound)).toISOString();
const exUnix = roundTime(exRound) / 1000;
const kib = (n: number) => `${(n / 1024).toLocaleString("en-US")} KiB`;
const mib = (n: number) => `${n / 1024 / 1024} MiB`;
const errors: [number, string, string][] = [
	[400, "invalid_json", "Body isn't a JSON object."],
	[400, "invalid_request", "A field is missing or invalid; `message` says which."],
	[403, "forbidden", "Cross-origin call to an endpoint reserved for the website."],
	[405, "method_not_allowed", "Wrong HTTP method."],
	[413, "payload_too_large", "Body or plaintext over the limit; includes `limitBytes`."],
	[422, "invalid_ciphertext", "Not a tlock age ciphertext, or it's corrupted."],
	[422, "unsupported_chain", "Ciphertext was made for a drand chain other than quicknet."],
	[425, "too_early", "Unlock round not reached yet; includes `round`, `unlockAt`, `unlockAtUnix`."],
	[500, "internal_error", "Unexpected server error."],
	[502, "drand_unavailable", "No drand relay answered. Retry with backoff."],
	[503, "feed_unavailable", "The activity database isn't set up."],
];
const toc: [string, string, string?][] = [
	["encrypt", "/api/encrypt", "POST"],
	["decrypt", "/api/decrypt", "POST"],
	["events", "/api/events", "GET"],
	["stats", "/api/stats", "GET"],
	["legacy", "Original endpoints"],
	["errors", "Errors"],
	["limits", "Limits"],
];
---

<Base title="API · timelock.dev" description="JSON API for timelock encryption: encrypt and decrypt messages tied to drand quicknet rounds. Includes curl examples, schemas, errors and limits.">
	<div class="container layout">
		<article class="layout-main markdown">
		<header class="page-head">
			<h1>API</h1>
			<p class="lead">
				Encrypt and decrypt from scripts with two JSON endpoints. The base URL is <code>https://timelock.dev</code>. There is no
				authentication, and any website can call it (CORS allows all origins).
			</p>
		</header>

		<div class="callout warning">
			<p>
				<strong>The API sees your message.</strong> These endpoints encrypt and decrypt on our server, so your message passes through it in
				memory. We never log or store it, but you have to trust us on that. For anything sensitive, use the <a href="/">website</a>, which
				encrypts in your browser, or <a href="/how-it-works#offline">encrypt offline</a>. All three make the same kind of file, so you can mix
				them.
			</p>
		</div>

		<h2 id="encrypt"><span class="method">POST</span>/api/encrypt</h2>
		<p>Encrypts a message so it can be decrypted only at or after a drand quicknet round. Give exactly one of <code>duration</code>, <code>unlockAt</code> or <code>round</code>.</p>
		<pre><code>curl -s https://timelock.dev/api/encrypt \
  -H 'Content-Type: application/json' \
  -d '&#123;"plaintext": "hello, future", "duration": "5m"&#125;'</code></pre>

		<h3>Request body</h3>
		<div class="table-wrap">
			<table class="api">
				<thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
				<tbody>
					<tr><td><code>plaintext</code></td><td>string, required</td><td>The message. Up to {kib(LIMITS.plaintextBytes)} after decoding.</td></tr>
					<tr><td><code>encoding</code></td><td><code>"utf8"</code> | <code>"base64"</code></td><td>How <code>plaintext</code> is encoded. Default <code>"utf8"</code>. Use base64 for binary data.</td></tr>
					<tr><td><code>duration</code></td><td>number | string</td><td>Seconds from now (<code>300</code>) or a duration string: <code>"90s"</code>, <code>"15m"</code>, <code>"2h30m"</code>, <code>"3 days 6 hours"</code>. Units: s, m, h, d, w, y (365 days).</td></tr>
					<tr><td><code>unlockAt</code></td><td>number | string</td><td>Unix seconds, or ISO 8601 with a time zone: <code>"2030-01-01T00:00:00Z"</code>, <code>"2030-01-01T09:00:00+09:00"</code>. Must be in the future.</td></tr>
					<tr><td><code>round</code></td><td>integer</td><td>An exact quicknet round. Past rounds are allowed, and the result can be decrypted right away.</td></tr>
				</tbody>
			</table>
		</div>
		<p class="small muted">Times round <em>up</em> to the next round. There is one every {QUICKNET.period} seconds, so <code>unlockAt</code> in the response can be up to {QUICKNET.period} seconds later than you asked for. The maximum is {LIMITS.maxUnlockSeconds / (365 * 86400)} years ahead.</p>

		<h3>Response <code>200</code></h3>
		<pre><code>&#123;
  "ciphertext": "-----BEGIN AGE ENCRYPTED FILE-----\nYWdlLWVuY3J5cHRpb24ub3JnL3YxCi0+IHRsb2Nr…\n-----END AGE ENCRYPTED FILE-----\n",
  "round": {exRound},
  "unlockAt": "{exUnlock}",
  "unlockAtUnix": {exUnix},
  "chainHash": "{QUICKNET.hash}",
  "network": "quicknet"
&#125;</code></pre>

		<h3>More examples</h3>
		<pre><code># unlock at a specific moment
curl -s https://timelock.dev/api/encrypt \
  -d '&#123;"plaintext": "Happy new year!", "unlockAt": "2030-01-01T00:00:00Z"&#125;'

# binary data, ciphertext saved to a file (needs jq)
curl -s https://timelock.dev/api/encrypt \
  -d "&#123;\"plaintext\": \"$(base64 -w0 photo.jpg)\", \"encoding\": \"base64\", \"duration\": \"30d\"&#125;" \
  | jq -r .ciphertext > photo.jpg.age</code></pre>

		<h2 id="decrypt"><span class="method">POST</span>/api/decrypt</h2>
		<p>Decrypts a message after its round is published. It accepts armored quicknet files made by this site, the API, <code>dee</code>, <code>tlock</code> or <code>tlock-js</code>.</p>
		<pre><code>curl -s https://timelock.dev/api/decrypt \
  -H 'Content-Type: application/json' \
  -d "$(jq -Rs '&#123;ciphertext: .&#125;' message.age)"</code></pre>
		<h3>Request body</h3>
		<div class="table-wrap">
			<table class="api">
				<thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
				<tbody>
					<tr><td><code>ciphertext</code></td><td>string, required</td><td>Armored age text, <code>-----BEGIN AGE ENCRYPTED FILE-----</code> … <code>-----END AGE ENCRYPTED FILE-----</code>.</td></tr>
					<tr><td><code>encoding</code></td><td><code>"base64"</code></td><td>Optional. Return base64 even when the message is valid UTF-8 text.</td></tr>
				</tbody>
			</table>
		</div>
		<h3>Response <code>200</code></h3>
		<pre><code>&#123;
  "plaintext": "hello, future",
  "encoding": "utf8",
  "round": {exRound},
  "unlockAt": "{exUnlock}",
  "unlockAtUnix": {exUnix}
&#125;</code></pre>
		<p class="small">If the message isn't valid UTF-8 text, it comes back as base64 with <code>"encoding": "base64"</code>.</p>
		<h3>Too early: <code>425</code></h3>
		<pre><code>&#123;
  "error": &#123;
    "code": "too_early",
    "message": "Too early: this message unlocks at drand round {exRound} ({exUnlock}).",
    "round": {exRound},
    "unlockAt": "{exUnlock}",
    "unlockAtUnix": {exUnix}
  &#125;
&#125;</code></pre>

		<h2 id="events"><span class="method get">GET</span>/api/events</h2>
		<p>The rows behind <a href="/#activity">recent activity</a> on the homepage, newest first. They contain no messages, encrypted text or IP addresses.</p>
		<pre><code>curl -s 'https://timelock.dev/api/events?limit=2'</code></pre>
		<div class="table-wrap">
			<table class="api">
				<thead><tr><th>Query</th><th>Description</th></tr></thead>
				<tbody>
					<tr><td><code>limit</code></td><td>1 to {LIMITS.feedPageSize}, default 20.</td></tr>
					<tr><td><code>before</code></td><td>Return events with a lower id than this. To get the next page, pass the previous <code>nextBefore</code>.</td></tr>
				</tbody>
			</table>
		</div>
		<pre><code>&#123;
  "events": [
    &#123;
      "id": 42,
      "type": "decrypt",
      "source": "api",
      "createdAt": "2026-10-22T01:06:10.512Z",
      "round": {exRound},
      "unlockAt": "{exUnlock}"
    &#125;,
    &#123;
      "id": 41,
      "type": "encrypt",
      "source": "web",
      "createdAt": "2026-10-22T01:00:01.204Z",
      "round": {exRound},
      "unlockAt": "{exUnlock}"
    &#125;
  ],
  "nextBefore": 41
&#125;</code></pre>
		<p class="small"><code>source</code> is <code>"web"</code> or <code>"api"</code>. The website reports its own events after your browser finishes, so we can't verify them. The server records API events itself. <code>nextBefore</code> is <code>null</code> on the last page. Responses may be cached for 5 seconds. <code>POST /api/events</code> is only for the website and accepts same-origin requests only.</p>

		<h2 id="stats"><span class="method get">GET</span>/api/stats</h2>
		<p>Counts for the last {STATS_DAYS} days, as shown on the homepage. <code>averageLockSeconds</code> is the average time between encrypting and the unlock time, over encryptions in that window. It is <code>null</code> when there are none.</p>
		<pre><code>curl -s https://timelock.dev/api/stats</code></pre>
		<pre><code>&#123;
  "days": {STATS_DAYS},
  "encrypted": 55,
  "decrypted": 30,
  "averageLockSeconds": 11520
&#125;</code></pre>

		<h2 id="legacy">Original endpoints</h2>
		<p>The endpoints from the original Rust worker still work, so old scripts keep running. You send raw bytes and get raw bytes back, with no JSON. Uploads can be up to {mib(LIMITS.legacyBodyBytes)}.</p>
		<h3><span class="method">POST</span>/encrypt/:round</h3>
		<p>Send the message as raw bytes. You get back the armored age file (<code>Content-Type: application/octet-stream</code>). To find the round for a time, use <code>/api/encrypt</code> or <code>dee</code>.</p>
		<pre><code>curl -s -X POST --data-binary @original.png https://timelock.dev/encrypt/{exRound} > encrypted.age</code></pre>
		<h3><span class="method">POST</span>/decrypt</h3>
		<p>Send an armored <em>or</em> binary age file. You get back the message as raw bytes.</p>
		<pre><code>curl -s -X POST --data-binary @encrypted.age https://timelock.dev/decrypt > decrypted.png</code></pre>
		<p class="small">Errors on these endpoints are plain text, with the HTTP status codes listed below. For example, you get <code>425</code> when it's too early.</p>

		<h2 id="errors">Errors</h2>
		<p>JSON endpoints return <code>&#123;"error": &#123;"code": "…", "message": "…"&#125;&#125;</code>, plus extra fields where noted.</p>
		<div class="table-wrap">
			<table class="api">
				<thead><tr><th>Status</th><th>Code</th><th>Meaning</th></tr></thead>
				<tbody>
					{errors.map(([status, code, meaning]) => <tr><td>{status}</td><td><code>{code}</code></td><td>{meaning}</td></tr>)}
				</tbody>
			</table>
		</div>

		<h2 id="limits">Limits</h2>
		<ul>
			<li>JSON API: messages up to {kib(LIMITS.plaintextBytes)} after decoding, and request bodies up to {kib(LIMITS.jsonBodyBytes)}.</li>
			<li>Original endpoints: up to {mib(LIMITS.legacyBodyBytes)} per request. For bigger files, encrypt offline with <code>dee</code>, which has no size limit.</li>
			<li>Unlock time: up to {LIMITS.maxUnlockSeconds / (365 * 86400)} years ahead, at {QUICKNET.period}-second granularity.</li>
			<li>Network: drand quicknet only, chain hash <code>{QUICKNET.hash}</code>.</li>
			<li>Cloudflare may slow down abusive traffic. If you get <code>502</code>, wait and retry.</li>
		</ul>
		</article>

		<aside class="layout-side sticky toc-side" aria-label="On this page">
			<nav class="Box">
				<div class="Box-header compact"><h2 class="Box-title">On this page</h2></div>
				<ul class="toc">
					{toc.map(([id, label, method]) => <li><a href={`#${id}`}>{method ? <><span class={`method ${method === "GET" ? "get" : ""}`}>{method}</span><code>{label}</code></> : label}</a></li>)}
				</ul>
			</nav>
		</aside>
	</div>
</Base>

<style>
	@media (max-width: 1011px) {
		.toc-side {
			display: none;
		}
	}
</style>
