---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import VerifyBadge from "../components/VerifyBadge.astro";
import type { IconName } from "../lib/icons";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/(\.html)?\/?$/, "") || "/";
const nav: { href: string; label: string; icon: IconName }[] = [
	{ href: "/how-it-works", label: "How it works", icon: "book" },
	{ href: "/docs", label: "API", icon: "code" },
];
const repo = "https://github.com/timelock-dev/tlock-worker";
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ""), Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="theme-color" content="#ffffff" />
	</head>
	<body>
		<header class="app-header">
			<div class="container header-row">
				<Logo size={24} />
				<VerifyBadge />
				<nav class="header-nav" aria-label="Main">
					{
						nav.map((item) => (
							<a href={item.href} aria-current={item.href === path ? "page" : undefined}>
								{item.label}
							</a>
						))
					}
					<a class="github-btn" href={repo}><Icon name="github" /><span>GitHub</span></a>
				</nav>
				<details class="menu">
					<summary class="menu-btn" aria-label="Menu"><span class="menu-open"><Icon name="menu" /></span><span class="menu-close"><Icon name="x" /></span></summary>
					<nav class="menu-panel" aria-label="Main">
						{
							nav.map((item) => (
								<a href={item.href} aria-current={item.href === path ? "page" : undefined}>
									<Icon name={item.icon} />
									<span>{item.label}</span>
								</a>
							))
						}
						<a href={repo}><Icon name="github" /><span>GitHub</span></a>
					</nav>
				</details>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<span class="footer-brand"><Logo size={16} /><span>© {new Date().getFullYear()} · Keys from <a href="https://drand.love/">drand</a></span></span>
				<span class="footer-links">
					<a href="https://github.com/timelock-dev/tlock-worker">Source on GitHub</a>
					<a href="https://x.com/_alanreed">@_alanreed</a>
					<a href="mailto:contact@timelock.dev">contact@timelock.dev</a>
				</span>
			</div>
		</footer>
	</body>
</html>

<style>
	.app-header {
		position: relative;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}
	.header-row {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 60px;
	}
	.header-nav {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-left: auto;
	}
	.header-nav a {
		padding: 6px 10px;
		border-radius: var(--radius);
		color: var(--text);
		font-size: 14px;
		font-weight: 500;
		white-space: nowrap;
	}
	.header-nav a:hover {
		background: var(--canvas-subtle);
		text-decoration: none;
	}
	.header-nav a[aria-current="page"] {
		color: var(--green-text);
		background: var(--mint);
	}
	.header-nav .github-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-left: 8px;
		border: 1px solid var(--border);
	}
	.menu {
		display: none;
		margin-left: auto;
	}
	.menu-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		cursor: pointer;
		list-style: none;
	}
	.menu-btn::-webkit-details-marker {
		display: none;
	}
	.menu-close,
	.menu[open] .menu-open {
		display: none;
	}
	.menu[open] .menu-close {
		display: inline-flex;
	}
	.menu-open {
		display: inline-flex;
	}
	.menu-panel {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		z-index: 20;
		display: grid;
		padding: 8px 16px 16px;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
		box-shadow: var(--shadow-lg);
	}
	.menu-panel a {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 8px;
		border-radius: var(--radius);
		color: var(--text);
		font-size: 16px;
		font-weight: 500;
	}
	.menu-panel a + a {
		border-top: 1px solid var(--border-muted);
	}
	.menu-panel a:hover {
		background: var(--canvas-subtle);
		text-decoration: none;
	}
	.menu-panel a[aria-current="page"] {
		color: var(--green-text);
	}
	.menu-panel :global(.octicon) {
		color: var(--muted);
	}
	@media (max-width: 767px) {
		.header-nav {
			display: none;
		}
		.menu {
			display: block;
		}
	}
	main {
		flex: 1;
		padding: 24px 0 48px;
	}
	.site-footer {
		border-top: 1px solid var(--border);
		font-size: 12px;
		color: var(--muted);
	}
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 16px;
		padding-top: 16px;
		padding-bottom: 16px;
	}
	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}
</style>
