{
	"name": "tlock-worker",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"author": "Thibault <contact@thibaultmeunier.com>",
	"contributors": [
		"Alan Reed"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"postinstall": "patch-package",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && wrangler dev --port 4328",
		"check": "astro check && tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"db:migrate:local": "wrangler d1 migrations apply timelock-events --local",
		"db:migrate:remote": "wrangler d1 migrations apply timelock-events --remote",
		"cf-typegen": "wrangler types",
		"deploy": "astro build && wrangler deploy"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.2",
		"astro": "^7.4.2",
		"drand-client": "1.2.5",
		"tlock-js": "0.9.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"patch-package": "^8.0.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.3"
	}
}
