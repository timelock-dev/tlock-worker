{
	"name": "tlock-worker",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"author": "Thibault <contact@thibaultmeunier.com>",
	"contributors": [
		"Alan Reed"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"postinstall": "patch-package",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && wrangler dev --port 4328",
		"check": "astro check && tsc -p test/tsconfig.json",
		"test": "vitest run",
		"db:migrate:local": "wrangler d1 migrations apply timelock-events --local",
		"db:migrate:remote": "CI=true wrangler d1 migrations apply timelock-events --remote",
		"cf-typegen": "wrangler types",
		"deploy": "npm run db:migrate:remote && wrangler deploy",
		"spellcheck": "cspell --no-progress \"src/**/*.{astro,ts,css}\" \"test/**/*.ts\" \"*.md\" \"migrations/*.sql\"",
		"linkcheck": "linkinator http://127.0.0.1:4328/ --recurse --check-fragments"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.2",
		"astro": "^7.4.2",
		"drand-client": "1.2.5",
		"tlock-js": "0.9.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@types/node": "^22.20.5",
		"cspell": "^10.4.0",
		"linkinator": "^8.1.0",
		"patch-package": "^8.0.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.3"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261012.1": true,
		"workerd@1.20261019.1": true,
		"fsevents": false
	}
}
